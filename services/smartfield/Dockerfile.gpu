# =============================================================================
# Smartfield — GPU build (NVIDIA CUDA 12.1 + cuDNN 8)
#
# Requires: NVIDIA Container Toolkit on the host, --gpus all at runtime.
# Network:  --network host so the container reaches the drone over WiFi.
# Display:  QT_QPA_PLATFORM=offscreen by default (headless).
#           Pass -e DISPLAY=$DISPLAY -v /tmp/.X11-unix:/tmp/.X11-unix to
#           forward the tracking window to the host desktop.
# =============================================================================

FROM nvidia/cuda:12.1.1-cudnn8-runtime-ubuntu22.04

ARG APP_PORT=9000

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    # CUDA — expose all devices for compute + video decode
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility,video \
    # Olympe ships bundled C libs here; must be on LD_LIBRARY_PATH
    LD_LIBRARY_PATH=/usr/local/lib/python3.10/dist-packages/olympe_deps:/usr/local/lib \
    # Suppress Olympe's extremely verbose default logging
    OLYMPE_LOG_LEVEL=WARNING \
    # OpenCV offscreen rendering — no physical display needed inside the container
    QT_QPA_PLATFORM=offscreen \
    QT_X11_NO_MITSHM=1 \
    # YOLO weights baked into the image at build time (no internet on first start)
    YOLO_CONFIG_DIR=/app/.ultralytics \
    MISSION_LOGS_DIR=/logs/mission \
    APP_PORT=${APP_PORT}

# ── System dependencies ───────────────────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
    # Python
    python3.10 \
    python3.10-dev \
    python3-pip \
    python3-setuptools \
    # Build tools — needed for native pip extensions
    build-essential \
    cmake \
    pkg-config \
    libssl-dev \
    libffi-dev \
    # OpenCV headless rendering
    libgl1-mesa-glx \
    libgl1 \
    libglx-mesa0 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender1 \
    libxfixes3 \
    libgomp1 \
    xvfb \
    # FFmpeg + codec libs — Olympe video decode pipeline
    ffmpeg \
    libavcodec-dev \
    libavformat-dev \
    libavutil-dev \
    libswscale-dev \
    libswresample-dev \
    libavdevice-dev \
    # SDL2 — PySDL2 / Olympe media player backend
    libsdl2-2.0-0 \
    libsdl2-dev \
    # GStreamer — required by Olympe's pdraw streaming engine
    libgstreamer1.0-dev \
    libgstreamer-plugins-base1.0-dev \
    gstreamer1.0-plugins-base \
    gstreamer1.0-plugins-good \
    gstreamer1.0-plugins-bad \
    gstreamer1.0-libav \
    # USB — drone hardware interface
    libusb-1.0-0 \
    # Utilities
    curl \
    iproute2 \
    && rm -rf /var/lib/apt/lists/*

RUN update-alternatives --install /usr/bin/python  python  /usr/bin/python3.10 1 && \
    update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.10 1 && \
    update-alternatives --install /usr/bin/pip     pip     /usr/bin/pip3       1

# ── Python dependencies ───────────────────────────────────────────────────────
WORKDIR /app

COPY requirements.txt .

# requirements.txt is a full pip freeze that includes both opencv-python (GUI)
# and opencv-python-headless — they conflict. Drop the GUI build; headless is
# correct for containerised offscreen rendering.
RUN pip install --no-cache-dir --upgrade pip && \
    grep -v "^opencv-python==" requirements.txt > /tmp/req.txt && \
    pip install --no-cache-dir -r /tmp/req.txt && \
    rm /tmp/req.txt

# Verify Olympe loads correctly with its bundled libs
RUN python -c "import olympe; print('olympe OK')"

# Bake YOLO weights into the image — containers start without internet access
RUN python -c "from ultralytics import YOLO; YOLO('yolov5su')" && \
    echo "YOLO weights cached"

# ── Application source ────────────────────────────────────────────────────────
COPY . .

RUN mkdir -p /logs/mission

VOLUME ["/logs/mission"]

EXPOSE ${APP_PORT}

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:${APP_PORT}/health || exit 1

CMD ["python", "api.py"]
